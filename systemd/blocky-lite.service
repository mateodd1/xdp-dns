[Unit]
Description=XDP Lite DNS Resolver (IP evasion without ad blocking)
After=network.target unbound.service xdp-evade-proxy.service
Wants=unbound.service xdp-evade-proxy.service

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/blocky --config /root/xpd-dns/blocky/config-lite.yml
Restart=always
RestartSec=3s
LimitNOFILE=1048576
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
