# Environment variables & local secrets
.env

# Runtime caches and dynamic statistics generated by scripts
scripts/history.json
scripts/services_history.json
scripts/asn_cache.json
scripts/evade_stats.json
web/stats.json
web/stats/stats.json

# Signed mobileconfig files (contain cert chains / signatures generated on server)
web/*.signed.mobileconfig

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/

# OS / Editor artifacts
.DS_Store
.vscode/
.idea/

# Generated dashboard snapshot (written every minute by update-blocked-ips.timer)
web/blocked/data.json

# Blocklists y prefijos sincronizados en runtime (datos, no código)
unbound/blocked_ips.txt
unbound/blocked_ipv6.txt
unbound/cloudflare_prefixes_v4.txt
unbound/cloudflare_prefixes_v6.txt
