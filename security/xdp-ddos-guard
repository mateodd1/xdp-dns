#!/usr/bin/env python3
"""Atomically replace only our table; leave other firewall owners untouched."""
from pathlib import Path
import subprocess
import sys

exists = subprocess.run(['nft', 'list', 'table', 'inet', 'xdp_ddos'],
                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
batch = 'delete table inet xdp_ddos\n' if exists else ''
if sys.argv[1:] == ['apply']:
    batch += Path('/etc/nftables.d/xdp-ddos.nft').read_text()
elif sys.argv[1:] != ['remove']:
    raise SystemExit('usage: xdp-ddos-guard apply|remove')
if batch:
    subprocess.run(['nft', '-c', '-f', '-'], input=batch, text=True, check=True)
    subprocess.run(['nft', '-f', '-'], input=batch, text=True, check=True)
