# /etc/caddy/Caddyfile
# Caddy configuration with Wildcard TLS (*.xdp.es) for xdp.es, dns.xdp.es and all subdomains
{
	email admin@xdp.es
	# Enable HTTP/3 (QUIC) for ultra-low latency DoH
	servers {
		protocols h1 h2 h3
	}
}

# Dedicated DoH & DoT Subdomain (dns.xdp.es)
dns.xdp.es {
	tls /etc/letsencrypt/live/xdp.es/fullchain.pem /etc/letsencrypt/live/xdp.es/privkey.pem

	handle /block-ota/dns-query* {
		rewrite * /dns-query
		reverse_proxy 127.0.0.1:4001 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
		}
	}

	handle /dns-query* {
		reverse_proxy 127.0.0.1:4000 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
		}
	}
	handle /.well-known/dns-query* {
		reverse_proxy 127.0.0.1:4000 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
		}
	}

	handle /api/ip {
		header Content-Type "text/plain; charset=utf-8"
		header Cache-Control "no-store, no-cache, must-revalidate"
		respond "{remote_host}" 200
	}

	handle /api/geoip {
		rewrite * /json/{remote_host}?fields=status,message,country,countryCode,region,regionName,city,zip,lat,lon,timezone,isp,org,as,query
		reverse_proxy http://ip-api.com {
			header_up Host ip-api.com
			header_down Cache-Control "public, max-age=3600"
		}
	}

	@stats path /stats.json /stats/stats.json
	handle @stats {
		root * /var/www/xdp.es
		header Content-Type "application/json; charset=utf-8"
		header Cache-Control "public, max-age=15, must-revalidate"
		file_server
	}

	@stats_page path /stats /stats/ /stats/index.html
	handle @stats_page {
		root * /var/www/xdp.es
		header Content-Type "text/html; charset=utf-8"
		header Cache-Control "public, max-age=60, must-revalidate"
		rewrite * /stats/index.html
		file_server
	}

	@block_ota_page path /block-ota /block-ota/ /block-ota/index.html
	handle @block_ota_page {
		root * /var/www/xdp.es
		header Content-Type "text/html; charset=utf-8"
		header Cache-Control "public, max-age=60, must-revalidate"
		rewrite * /block-ota/index.html
		file_server
	}

	@assets path /index.css /index.js /theme.js /i18n.js /stats.js /llms.txt /llms-full.txt /openapi.json /robots.txt /sitemap.xml /favicon.ico *.mobileconfig *.svg *.png *.ico *.css *.js
	handle @assets {
		root * /var/www/xdp.es
		header Cache-Control "public, max-age=86400"
		file_server
	}

	handle {
		redir https://xdp.es/ permanent
	}

	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Access-Control-Allow-Origin "*"
		Access-Control-Allow-Methods "GET, POST, OPTIONS"
		Access-Control-Allow-Headers "Content-Type, Accept"
	}

	log {
		output file /var/log/caddy/dns.xdp.es.access.log {
			roll_size 20mb
			roll_keep 5
		}
	}
}

# Main Canonical Landing Page (xdp.es)
xdp.es {
	tls /etc/letsencrypt/live/xdp.es/fullchain.pem /etc/letsencrypt/live/xdp.es/privkey.pem
	root * /var/www/xdp.es

	handle /.well-known/dns-query* {
		redir https://dns.xdp.es/dns-query permanent
	}

	handle /block-ota/dns-query* {
		redir https://dns.xdp.es{uri} permanent
	}

	handle /api/ip {
		header Content-Type "text/plain; charset=utf-8"
		header Cache-Control "no-store, no-cache, must-revalidate"
		respond "{remote_host}" 200
	}

	handle /api/geoip {
		rewrite * /json/{remote_host}?fields=status,message,country,countryCode,region,regionName,city,zip,lat,lon,timezone,isp,org,as,query
		reverse_proxy http://ip-api.com {
			header_up Host ip-api.com
			header_down Cache-Control "public, max-age=3600"
		}
	}

	@stats path /stats.json /stats/stats.json
	handle @stats {
		header Content-Type "application/json; charset=utf-8"
		header Cache-Control "public, max-age=15, must-revalidate"
		file_server
	}

	@stats_page path /stats /stats/ /stats/index.html
	handle @stats_page {
		header Content-Type "text/html; charset=utf-8"
		header Cache-Control "public, max-age=60, must-revalidate"
		rewrite * /stats/index.html
		file_server
	}

	@block_ota_page path /block-ota /block-ota/ /block-ota/index.html
	handle @block_ota_page {
		header Content-Type "text/html; charset=utf-8"
		header Cache-Control "public, max-age=60, must-revalidate"
		rewrite * /block-ota/index.html
		file_server
	}

	@known_assets path /index.css /index.js /theme.js /i18n.js /stats.js /llms.txt /llms-full.txt /openapi.json /robots.txt /sitemap.xml /favicon.ico *.mobileconfig *.svg *.png *.ico
	handle @known_assets {
		@css path *.css
		header @css Content-Type "text/css; charset=utf-8"
		header @css Cache-Control "public, max-age=31536000, immutable"

		@js path *.js
		header @js Content-Type "application/javascript; charset=utf-8"
		header @js Cache-Control "public, max-age=31536000, immutable"

		@json path *.json
		header @json Content-Type "application/json; charset=utf-8"
		header @json Cache-Control "public, max-age=3600"

		@txt path *.txt
		header @txt Content-Type "text/markdown; charset=utf-8"
		header @txt Cache-Control "public, max-age=86400"

		@xml path *.xml
		header @xml Content-Type "application/xml; charset=utf-8"
		header @xml Cache-Control "public, max-age=86400"

		@mobileconfig path *.mobileconfig
		header @mobileconfig Content-Type "application/x-apple-aspen-config"
		header @mobileconfig Cache-Control "public, max-age=86400"

		file_server
	}

	@home path / /index.html
	handle @home {
		header Cache-Control "public, max-age=60, must-revalidate"
		rewrite * /index.html
		file_server
	}

	handle {
		redir https://xdp.es/ 302
	}

	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Access-Control-Allow-Origin "*"
		Access-Control-Allow-Methods "GET, POST, OPTIONS"
		Access-Control-Allow-Headers "Content-Type, Accept"
	}

	log {
		output file /var/log/caddy/xdp.es.access.log {
			roll_size 20mb
			roll_keep 5
		}
	}
}

# Wildcard Subdomains (*.xdp.es) -> Instant redirect to https://xdp.es/ with Wildcard TLS
*.xdp.es {
	tls /etc/letsencrypt/live/xdp.es/fullchain.pem /etc/letsencrypt/live/xdp.es/privkey.pem
	redir https://xdp.es/ permanent
}

# Catch-all on HTTP for non-xdp.es hostnames or direct IP
http:// {
	@not_xdp {
		not header_regexp Host ^([a-zA-Z0-9-]+\.)*xdp\.es(:[0-9]+)?$
	}
	handle @not_xdp {
		respond "Not Found" 404 {
			close
		}
	}
}
