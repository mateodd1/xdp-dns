# /etc/caddy/Caddyfile
# Caddy configuration with Wildcard TLS (*.xdp.es) for xdp.es, dns.xdp.es and all subdomains
{
	email admin@xdp.es
	# Sin SNI (clientes por IP, sobre todo QUIC/h3): usar el cert de dns.xdp.es, que incluye las IPs
	default_sni dns.xdp.es
	# Encrypted ClientHello: el SNI real (dns.xdp.es, lite...) viaja cifrado; el SNI visible es xdp.es.
	# Publicación del registro HTTPS (ech=) en Cloudflare: scripts/xdp-ech-publish.sh (timer).
	ech xdp.es
	# Enable HTTP/3 (QUIC) for ultra-low latency DoH
	servers {
		protocols h1 h2 h3
	}
	# Zero-Logs Guarantee: Discard all server access logs
	log {
		output discard
	}
}

# Lite resolver: IP-evasion and DNSSEC, deliberately without ad blocking.
lite.xdp.es {
	tls /etc/xdp-tls/fullchain.pem /etc/xdp-tls/privkey.pem

	handle /dns-query* {
		reverse_proxy 127.0.0.1:4002 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
		}
	}

	handle /.well-known/acme-challenge/* {
		root * /var/www/acme
		file_server
	}

	handle {
		redir https://xdp.es{uri} permanent
	}

	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		# Preserve upstream CORS; provide defaults only when absent.
		?Access-Control-Allow-Origin "*"
		?Access-Control-Allow-Methods "GET, POST, OPTIONS"
		?Access-Control-Allow-Headers "Content-Type, Accept"
	}
}

# Dedicated DoH & DoT Subdomain (dns.xdp.es) - EXCLUSIVELY FOR DNS QUERIES
dns.xdp.es {
	tls /etc/xdp-tls/fullchain.pem /etc/xdp-tls/privkey.pem

	handle /block-ota/dns-query* {
		rewrite * /dns-query
		reverse_proxy 127.0.0.1:4001 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
		}
	}

	handle /dns-query* {
		reverse_proxy 127.0.0.1:4000 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
		}
	}

	handle /.well-known/dns-query* {
		reverse_proxy 127.0.0.1:4000 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
		}
	}

	# Ingesta de la sonda residencial (token verificado dentro del propio servicio)
	handle /probe/* {
		reverse_proxy 127.0.0.1:8090
	}

	handle /.well-known/acme-challenge/* {
		root * /var/www/acme
		file_server
	}

	# Any non-DNS request on dns.xdp.es is redirected immediately to the canonical web domain xdp.es
	handle {
		redir https://xdp.es{uri} permanent
	}

	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		# Preserve upstream CORS; provide defaults only when absent.
		?Access-Control-Allow-Origin "*"
		?Access-Control-Allow-Methods "GET, POST, OPTIONS"
		?Access-Control-Allow-Headers "Content-Type, Accept"
	}
}

# Acceso DoH por IP (clientes que no usan SNI/hostname). Cert con IPs en SAN.
https://85.208.114.51, https://85.208.114.54, https://[2a0e:97c0:c40::51], https://[2a0e:97c0:c40::54] {
	tls /etc/xdp-tls/fullchain.pem /etc/xdp-tls/privkey.pem
	handle /dns-query* {
		reverse_proxy 127.0.0.1:4000 {
			header_up Host dns.xdp.es
			header_up X-Real-IP {remote_host}
		}
	}
	handle /.well-known/dns-query* {
		reverse_proxy 127.0.0.1:4000 {
			header_up Host dns.xdp.es
			header_up X-Real-IP {remote_host}
		}
	}
	handle {
		redir https://xdp.es{uri} permanent
	}
}

https://85.208.114.52, https://[2a0e:97c0:c40::52] {
	tls /etc/xdp-tls/fullchain.pem /etc/xdp-tls/privkey.pem
	handle /dns-query* {
		reverse_proxy 127.0.0.1:4002 {
			header_up Host lite.xdp.es
			header_up X-Real-IP {remote_host}
		}
	}
	handle {
		redir https://xdp.es{uri} permanent
	}
}

# Main Canonical Landing Page (xdp.es)
xdp.es {
	tls /etc/letsencrypt/live/xdp.es/fullchain.pem /etc/letsencrypt/live/xdp.es/privkey.pem
	root * /var/www/xdp.es

	# Redirect any DNS queries on xdp.es to the dedicated dns.xdp.es subdomain
	handle /dns-query* {
		redir https://dns.xdp.es{uri} permanent
	}

	handle /.well-known/dns-query* {
		redir https://dns.xdp.es/dns-query permanent
	}

	handle /block-ota/dns-query* {
		redir https://dns.xdp.es{uri} permanent
	}

	handle /api/ip {
		header Content-Type "text/plain; charset=utf-8"
		header Cache-Control "no-store, no-cache, must-revalidate"
		respond "{remote_host}" 200
	}

	handle_path /api/geoip/* {
		rewrite * /json{path}?fields=status,message,country,countryCode,region,regionName,city,zip,lat,lon,timezone,isp,org,as,query
		reverse_proxy http://ip-api.com {
			header_up Host ip-api.com
			header_down Cache-Control "public, max-age=3600"
		}
	}

	handle /api/geoip {
		rewrite * /json/{remote_host}?fields=status,message,country,countryCode,region,regionName,city,zip,lat,lon,timezone,isp,org,as,query
		reverse_proxy http://ip-api.com {
			header_up Host ip-api.com
			header_down Cache-Control "public, max-age=3600"
		}
	}

	@stats path /stats.json /stats/stats.json
	handle @stats {
		header Content-Type "application/json; charset=utf-8"
		header Cache-Control "public, max-age=15, must-revalidate"
		file_server
	}

	@stats_page path /stats /stats/ /stats/index.html
	handle @stats_page {
		header Content-Type "text/html; charset=utf-8"
		header Cache-Control "public, max-age=60, must-revalidate"
		rewrite * /stats/index.html
		file_server
	}

	@block_ota_page path /block-ota /block-ota/ /block-ota/index.html
	handle @block_ota_page {
		header Content-Type "text/html; charset=utf-8"
		header Cache-Control "public, max-age=60, must-revalidate"
		rewrite * /block-ota/index.html
		file_server
	}

	@about_page path /about /about/ /about/index.html
	handle @about_page {
		header Content-Type "text/html; charset=utf-8"
		header Cache-Control "public, max-age=60, must-revalidate"
		rewrite * /about/index.html
		file_server
	}

	@blocked_data path /blocked/data.json
	handle @blocked_data {
		header Content-Type "application/json; charset=utf-8"
		header Cache-Control "public, no-cache, must-revalidate"
		file_server
	}

	@blocked_page path /blocked /blocked/ /blocked/index.html
	handle @blocked_page {
		header Content-Type "text/html; charset=utf-8"
		header Cache-Control "public, no-cache, must-revalidate"
		rewrite * /blocked/index.html
		file_server
	}

	@test_page path /test /test/ /test/index.html
	handle @test_page {
		header Content-Type "text/html; charset=utf-8"
		header Cache-Control "public, max-age=60, must-revalidate"
		rewrite * /test/index.html
		file_server
	}

	@internal_doc_page path /xUXJA8KK2pCeHjkJZamT /xUXJA8KK2pCeHjkJZamT/ /xUXJA8KK2pCeHjkJZamT/index.html
	handle @internal_doc_page {
		header Content-Type "text/html; charset=utf-8"
		header Cache-Control "public, no-cache, must-revalidate"
		rewrite * /xUXJA8KK2pCeHjkJZamT/index.html
		file_server
	}

	handle_path /test/api/* {
		reverse_proxy 127.0.0.1:8088
	}

	@known_assets path /index.css /index.js /theme.js /i18n.js /stats.js /llms.txt /llms-full.txt /openapi.json /robots.txt /sitemap.xml /favicon.ico /site.webmanifest *.mobileconfig *.svg *.png *.ico *.webmanifest
	handle @known_assets {
		@css path *.css
		header @css Content-Type "text/css; charset=utf-8"
		header @css Cache-Control "public, max-age=604800, stale-while-revalidate=86400"

		@js path *.js
		header @js Content-Type "application/javascript; charset=utf-8"
		header @js Cache-Control "public, max-age=604800, stale-while-revalidate=86400"

		@json path *.json
		header @json Content-Type "application/json; charset=utf-8"
		header @json Cache-Control "public, max-age=3600"

		@manifest path *.webmanifest /site.webmanifest
		header @manifest Content-Type "application/manifest+json; charset=utf-8"
		header @manifest Cache-Control "public, max-age=86400"

		@txt path *.txt
		header @txt Content-Type "text/markdown; charset=utf-8"
		header @txt Cache-Control "public, max-age=86400"

		@xml path *.xml
		header @xml Content-Type "application/xml; charset=utf-8"
		header @xml Cache-Control "public, max-age=86400"

		@mobileconfig path *.mobileconfig
		header @mobileconfig Content-Type "application/x-apple-aspen-config"
		header @mobileconfig Cache-Control "public, max-age=86400"

		file_server
	}

	@home path / /index.html
	handle @home {
		header Cache-Control "public, max-age=60, must-revalidate"
		rewrite * /index.html
		file_server
	}

	handle {
		redir https://xdp.es/ 302
	}

	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Access-Control-Allow-Origin "*"
		Access-Control-Allow-Methods "GET, POST, OPTIONS"
		Access-Control-Allow-Headers "Content-Type, Accept"
	}
}

# Wildcard Subdomains (*.xdp.es) -> Instant redirect to https://xdp.es/ with Wildcard TLS
*.xdp.es {
	tls /etc/letsencrypt/live/xdp.es/fullchain.pem /etc/letsencrypt/live/xdp.es/privkey.pem
	redir https://xdp.es/ permanent
}

# Catch-all on HTTP for non-xdp.es hostnames or direct IP
http:// {
	handle /.well-known/acme-challenge/* {
		root * /var/www/acme
		file_server
	}

	@not_xdp {
		not header_regexp Host ^([a-zA-Z0-9-]+\.)*xdp\.es(:[0-9]+)?$
	}
	handle @not_xdp {
		respond "Not Found" 404 {
			close
		}
	}
}
