# /root/xpd-dns/caddy/Caddyfile
# Caddy configuration for xdp.es, wildcard subdomains (*.xdp.es) and dns.xdp.es DoH endpoint

{
    email admin@xdp.es
    # Enable HTTP/3 (QUIC) for ultra-low latency DoH
    servers {
        protocols h1 h2 h3
    }
    # On-demand TLS to automatically issue certs for any requested subdomain
    on_demand_tls {
        interval 2m
        burst 5
    }
}

# Dedicated DoH & DoT Subdomain (dns.xdp.es)
dns.xdp.es {
    # Block-OTA DoH Endpoint (Proxied to Blocky-OTA on port 4001 with path rewrite to /dns-query)
    handle /block-ota/dns-query* {
        rewrite * /dns-query
        reverse_proxy 127.0.0.1:4001 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }

    # Standard RFC 8484 DoH & RFC 9462 DDR Discovery Endpoint (Proxied to Blocky on port 4000)
    handle /dns-query* {
        reverse_proxy 127.0.0.1:4000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }
    handle /.well-known/dns-query* {
        reverse_proxy 127.0.0.1:4000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }

    # Public stats.json endpoint (Explicit UTF-8)
    @stats path /stats.json /stats/stats.json
    handle @stats {
        root * /var/www/xdp.es
        header Content-Type "application/json; charset=utf-8"
        header Cache-Control "public, max-age=15, must-revalidate"
        file_server
    }

    # Dedicated Stats Page (/stats or /stats/)
    @stats_page path /stats /stats/ /stats/index.html
    handle @stats_page {
        root * /var/www/xdp.es
        header Content-Type "text/html; charset=utf-8"
        header Cache-Control "public, max-age=60, must-revalidate"
        rewrite * /stats/index.html
        file_server
    }

    # Dedicated Block-OTA Page (/block-ota or /block-ota/)
    @block_ota_page path /block-ota /block-ota/ /block-ota/index.html
    handle @block_ota_page {
        root * /var/www/xdp.es
        header Content-Type "text/html; charset=utf-8"
        header Cache-Control "public, max-age=60, must-revalidate"
        rewrite * /block-ota/index.html
        file_server
    }

    # Known Static assets & Machine-readable files
    @assets path /index.css /index.js /theme.js /stats.js /llms.txt /llms-full.txt /openapi.json /robots.txt /sitemap.xml /favicon.ico *.mobileconfig *.svg *.png *.ico *.css *.js
    handle @assets {
        root * /var/www/xdp.es
        header Cache-Control "public, max-age=86400"
        file_server
    }

    # Fallback: All other paths or root on dns.xdp.es redirect to main landing page https://xdp.es/
    handle {
        redir https://xdp.es/ permanent
    }

    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        Access-Control-Allow-Origin "*"
        Access-Control-Allow-Methods "GET, POST, OPTIONS"
        Access-Control-Allow-Headers "Content-Type, Accept"
    }

    log {
        output file /var/log/caddy/dns.xdp.es.access.log {
            roll_size 20mb
            roll_keep 5
        }
    }
}

# Main Canonical Landing Page (xdp.es)
xdp.es, http://85.208.114.51, http://127.0.0.1, http://localhost {
    root * /var/www/xdp.es

    # RFC 9462 DDR Discovery Endpoint
    handle /.well-known/dns-query* {
        redir https://dns.xdp.es/dns-query permanent
    }

    # Block-OTA DoH Endpoint (Redirect to dedicated endpoint)
    handle /block-ota/dns-query* {
        redir https://dns.xdp.es{uri} permanent
    }

    # Public stats.json endpoint (Explicit UTF-8)
    @stats path /stats.json /stats/stats.json
    handle @stats {
        header Content-Type "application/json; charset=utf-8"
        header Cache-Control "public, max-age=15, must-revalidate"
        file_server
    }

    # Dedicated Stats Page (/stats or /stats/)
    @stats_page path /stats /stats/ /stats/index.html
    handle @stats_page {
        header Content-Type "text/html; charset=utf-8"
        header Cache-Control "public, max-age=60, must-revalidate"
        rewrite * /stats/index.html
        file_server
    }

    # Dedicated Block-OTA Page (/block-ota or /block-ota/)
    @block_ota_page path /block-ota /block-ota/ /block-ota/index.html
    handle @block_ota_page {
        header Content-Type "text/html; charset=utf-8"
        header Cache-Control "public, max-age=60, must-revalidate"
        rewrite * /block-ota/index.html
        file_server
    }

    # Known Static Assets & Machine-Readable Files
    @known_assets path /index.css /index.js /theme.js /stats.js /llms.txt /llms-full.txt /openapi.json /robots.txt /sitemap.xml /favicon.ico *.mobileconfig *.svg *.png *.ico
    handle @known_assets {
        @css path *.css
        header @css Content-Type "text/css; charset=utf-8"
        header @css Cache-Control "public, max-age=31536000, immutable"

        @js path *.js
        header @js Content-Type "application/javascript; charset=utf-8"
        header @js Cache-Control "public, max-age=31536000, immutable"

        @json path *.json
        header @json Content-Type "application/json; charset=utf-8"
        header @json Cache-Control "public, max-age=3600"

        @txt path *.txt
        header @txt Content-Type "text/markdown; charset=utf-8"
        header @txt Cache-Control "public, max-age=86400"

        @xml path *.xml
        header @xml Content-Type "application/xml; charset=utf-8"
        header @xml Cache-Control "public, max-age=86400"

        @mobileconfig path *.mobileconfig
        header @mobileconfig Content-Type "application/x-apple-aspen-config"
        header @mobileconfig Cache-Control "public, max-age=86400"

        file_server
    }

    # Root Home Landing Page
    @home path / /index.html
    handle @home {
        header Cache-Control "public, max-age=60, must-revalidate"
        rewrite * /index.html
        file_server
    }

    # Catch-all: Redirect ALL other subdirectories, unknown paths and 404s to the main domain https://xdp.es/
    handle {
        redir https://xdp.es/ 302
    }

    # Security and Performance Headers
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Access-Control-Allow-Origin "*"
        Access-Control-Allow-Methods "GET, POST, OPTIONS"
        Access-Control-Allow-Headers "Content-Type, Accept"
    }

    log {
        output file /var/log/caddy/xdp.es.access.log {
            roll_size 20mb
            roll_keep 5
        }
    }
}

# Wildcard Subdomains (*.xdp.es) -> Redirect all other subdomains to the main domain https://xdp.es/
http://*.xdp.es, *.xdp.es {
    tls {
        on_demand
    }
    redir https://xdp.es/ permanent
}
